# =====================================================================
# Finora AI - environment configuration (Spring Boot backend)
#
# 1. Copy this file to `.env` in the SAME folder (the project root):
#        copy .env.example .env          (Windows)
# 2. Fill in the values you need. `.env` is git-ignored - NEVER commit it.
#
# The backend (started from the `backend` folder) reads ../.env automatically.
# Real environment variables ($env:NAME = "...") override values in this file.
# Frontend settings live in frontend/.env.example (VITE_* values are public!).
# =====================================================================

# --- Profile ----------------------------------------------------------
# dev  = in-memory H2 database + demo account (default, safe, no setup)
# prod = PostgreSQL (e.g. Neon) - requires the DB_* values below
SPRING_PROFILES_ACTIVE=dev

# Lines with an empty value are fine for text settings; for true/false
# settings comment the line out instead of leaving it empty.

# --- Database (prod profile only) -------------------------------------
# JDBC URL, e.g. jdbc:postgresql://<host>:5432/<database>?sslmode=require
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# validate (default, never changes tables) | update (lets Hibernate add tables/columns)
DDL_AUTO=validate

# --- Security ---------------------------------------------------------
# At least 32 random characters. Empty = a random key per start (everyone is
# logged out when the backend restarts). Generate one in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=
# Token lifetime in milliseconds (default 24 h)
JWT_EXPIRATION_MS=86400000

# Browser origins allowed to call the API (comma-separated; patterns allowed)
CORS_ORIGINS=http://localhost:5173

# --- AI Finance Coach (optional, OpenAI-compatible API, e.g. Groq) ----
# Keep false until you have a key. When off, the coach says so and shows
# clearly-labelled rule-based answers.
# NOTE: leave AI_API_KEY commented out (not empty) until you have a key -
# an empty value would stop the AI library from starting.
AI_ENABLED=false
# AI_API_KEY=your-rotated-key
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai

# --- Demo data --------------------------------------------------------
# Seed demo@finance.com / Demo@1234 on an empty database.
# Not set = true in the dev profile, false in prod. Uncomment to override.
# SEED_DEMO_DATA=true
