# Frontend env vars must start with VITE_ and are PUBLIC (bundled into the
# browser). Never put API keys or secrets here - those belong in the backend .env.

# Backend origin. Leave EMPTY in development: Vite proxies the Finora /api/* paths to the
# Spring Boot backend (http://localhost:8080) and the rest of /api to FastAPI (:8000).
# For a production build served separately from the backend, set it to the Spring origin,
# e.g. https://finora-api.example.com (and add your site to the backend's CORS_ORIGINS).
VITE_API_BASE_URL=

# Where Finora data lives:
#   api   (default) - the Spring Boot backend. Login required; data is per user.
#   local           - this browser's localStorage with labelled sample data (offline demo, no login)
VITE_FINORA_DATA_SOURCE=api

# AI Finance Coach:
#   (unset)  - follows the data source: api -> backend coach, local -> demo coach
#   api      - POST /api/ai/chat on the Spring backend (needs AI_ENABLED + AI_API_KEY there)
#   demo     - rule-based answers computed in the browser, labelled "Demo"
VITE_FINORA_COACH_MODE=

# Dev-proxy targets (only used by `npm run dev`)
# VITE_SPRING_PROXY_TARGET=http://localhost:8080
# VITE_PROXY_TARGET=http://localhost:8000
