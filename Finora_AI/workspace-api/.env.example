# ============================================================
# AgentForge environment configuration
# OPTIONAL AgentForge workspace API (FastAPI, port 8000) - only needed for the
# /workspace pages of the frontend. Finora itself uses the Spring Boot backend.
# Copy to `workspace-api/.env` and fill in values. `.env` is git-ignored.
# NEVER commit real keys. (This API also reads ../.env - the Finora root file -
# but values in workspace-api/.env win.)
# ============================================================

# --- App ---
APP_ENV=development
DEBUG=true

# --- Database ---
# SQLite (default, zero setup). Path is relative to the backend/ folder.
DATABASE_URL=sqlite:///./agentforge.db
# PostgreSQL (later): pip install "psycopg[binary]" then use:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agentforge

# Seed default roadmap/docs (and labelled sample team members) on first start
SEED_SAMPLE_DATA=true

# --- CORS (comma-separated frontend origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI provider ---
# none      -> agent endpoint reports "not configured" (default)
# openai    -> any OpenAI-compatible Chat Completions API
#              (OpenAI, Groq, OpenRouter, Together, Mistral, Ollama, LM Studio ...)
# anthropic -> Anthropic Messages API (Claude models)
AI_PROVIDER=none
# Model ID exactly as your provider names it (check the provider's model list)
AI_MODEL=
AI_API_KEY=
# Optional. Leave empty for the provider's default endpoint. Examples:
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1   (no API key needed)
AI_BASE_URL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024
AI_TIMEOUT_SECONDS=60

# --- Agent runtime ---
# Maximum reason/act iterations per request
AGENT_MAX_STEPS=6

# --- External APIs for the problem statement (add as needed) ---
# EXAMPLE_API_KEY=

